    </uix:NApplicationCard>
    <If Condition="[proxyBannerShown]" DisplayName="Stop a proxy left over from an earlier test" sap2010:WorkflowViewState.IdRef="If_3">
      <If.Then>
        <Sequence DisplayName="Stop leftover proxy" sap2010:WorkflowViewState.IdRef="Sequence_6">
          <ui:LogMessage DisplayName="Log leftover proxy" Level="Warn" Message="[&quot;A proxy session was still active before this test. Stopping it.&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
          <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Search Stop Proxy" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_4" UnSafe="False" WorkflowFileName="Workflows/Workday/SearchAndOpen.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="x:String" x:Key="in_SearchText">["Stop Proxy"]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_ResultText">["Stop Proxy"]</InArgument>
              <InArgument x:TypeArguments="x:TimeSpan" x:Key="WorkdayUiTimeout">[WorkdayUiTimeout]</InArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Stop Proxy" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_5" UnSafe="False" WorkflowFileName="Workflows/Workday/StopProxy.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="x:TimeSpan" x:Key="WorkdayUiTimeout">[WorkdayUiTimeout]</InArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
        </Sequence>
      </If.Then>
    </If>
    <Assign DisplayName="Return whether a proxy was active" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Boolean">[out_ProxyWasActive]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Boolean">[proxyBannerShown]</InArgument>
      </Assign.Value>
    </Assign>
  </Sequence>
