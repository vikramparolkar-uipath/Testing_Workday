  <Sequence DisplayName="Stop a Workday proxy if one is active" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Boolean" Name="proxyBannerShown" />
    </Sequence.Variables>
    <uix:NApplicationCard AttachMode="ByInstance" CloseMode="Never" ContinueOnError="True" DisplayName="Workday, if it is open" HealingAgentBehavior="Job" sap2010:WorkflowViewState.IdRef="NApplicationCard_1" OpenMode="Never" ScopeGuid="d4e5f6a7-0b1c-4d2e-8f3a-5b6c7d8e9f01" Timeout="[5]" Version="V2">
      <uix:NApplicationCard.Body>
        <ActivityAction x:TypeArguments="x:Object">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:Object" Name="WSSessionData" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Look for a leftover proxy" sap2010:WorkflowViewState.IdRef="Sequence_3">
            <uix:NCheckState DisplayName="Check for an 'On behalf of' proxy banner" Exists="[proxyBannerShown]" HealingAgentBehavior="Disabled" sap2010:WorkflowViewState.IdRef="NCheckState_1" ScopeIdentifier="d4e5f6a7-0b1c-4d2e-8f3a-5b6c7d8e9f01" Timeout="[3]" Version="V5">
              <uix:NCheckState.IfExists>
                <Sequence DisplayName="Proxy banner present" sap2010:WorkflowViewState.IdRef="Sequence_4" />
              </uix:NCheckState.IfExists>
              <uix:NCheckState.IfNotExists>
                <Sequence DisplayName="Proxy banner absent" sap2010:WorkflowViewState.IdRef="Sequence_5" />
              </uix:NCheckState.IfNotExists>
              <uix:NCheckState.Target>
                <uix:TargetAnchorable ElementType="Container" ElementVisibilityArgument="Interactive" FullSelectorArgument="&lt;webctrl data-automation-id='banner' tag='DIV' visibleinnertext='On behalf of:*' /&gt;" Guid="6a1d2c84-93be-4f57-b0e2-7c41d9a8f356" ScopeSelectorArgument="&lt;html app='msedge.exe' title='*Workday*' url='https://impl.workday.com/uipath_dpt1*' /&gt;" SearchSteps="Selector" Version="V6" WaitForReadyArgument="Interactive" />
              </uix:NCheckState.Target>
            </uix:NCheckState>
          </Sequence>
        </ActivityAction>
      </uix:NApplicationCard.Body>
      <uix:NApplicationCard.TargetApp>
        <uix:TargetApp BrowserType="Edge" Selector="&lt;html app='msedge.exe' title='*Workday*' url='https://impl.workday.com/uipath_dpt1*' /&gt;" Url="https://impl.workday.com/uipath_dpt1/d/home.htmld" Version="V3">
          <uix:TargetApp.SapInfo>
