  <Sequence DisplayName="TC-HR-HIRE-XX Workday test" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="t:WorkdayHireRun" Name="currentRun" />
      <Variable x:TypeArguments="x:String" Name="actualValue" />
      <Variable x:TypeArguments="x:String" Name="expectedValue" />
      <Variable x:TypeArguments="x:Boolean" Name="verifyResult" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
        <scg:Dictionary x:TypeArguments="x:String, x:Object">
          <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        </scg:Dictionary>
      </sap:WorkflowViewStateService.ViewState>
    <Sequence DisplayName="Given" sap2010:Annotation.AnnotationText="Pick the test data and put Workday in a known state. The test fails with 'Test data not available' if no run is at the required stage." sap2010:WorkflowViewState.IdRef="Sequence_Given">
      <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Select the hire run this test needs (fails if the test data is not available)" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" UnSafe="False" WorkflowFileName="Workflows/DataFabric/SelectHireRun.xaml">
        <ui:InvokeWorkflowFile.Arguments>
          <InArgument x:TypeArguments="x:String" x:Key="in_RunId">[in_RunId]</InArgument>
          <InArgument x:TypeArguments="t:HireRunStage" x:Key="in_RequiredStage">[Testing_Workday_CrossPlatform.HireRunStage.HireCompleted]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_TestCaseName">["TC-HR-HIRE-XX"]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_ProducedBy">["TC-HR-HIRE-04"]</InArgument>
          <OutArgument x:TypeArguments="t:WorkdayHireRun" x:Key="out_CurrentRun">[currentRun]</OutArgument>
        </ui:InvokeWorkflowFile.Arguments>
      </ui:InvokeWorkflowFile>
      <Assign DisplayName="Expose run ID" sap2010:WorkflowViewState.IdRef="Assign_RunId">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[out_RunId]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:String">[currentRun.RunId]</InArgument>
        </Assign.Value>
      </Assign>
      <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Prepare Workday: sign in as Logan and stop any leftover proxy" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_2" UnSafe="False" WorkflowFileName="Workflows/Workday/PrepareWorkdaySession.xaml">
        <ui:InvokeWorkflowFile.Arguments>
          <InArgument x:TypeArguments="x:TimeSpan" x:Key="WorkdayUiTimeout">[WorkdayUiTimeout]</InArgument>
        </ui:InvokeWorkflowFile.Arguments>
      </ui:InvokeWorkflowFile>
    </Sequence>
    <Sequence DisplayName="When" sap2010:WorkflowViewState.IdRef="Sequence_When">
      <uix:NApplicationCard AttachMode="ByInstance" CloseMode="Never" DisplayName="Workday" HealingAgentBehavior="Job" sap2010:WorkflowViewState.IdRef="NApplicationCard_1" OpenMode="Never" ScopeGuid="a1b2c3d4-0e0f-4a1b-9c2d-3e4f5a6b7c80" Timeout="[WorkdayUiTimeout.TotalSeconds]" Version="V2">
        <uix:NApplicationCard.Body>
          <ActivityAction x:TypeArguments="x:Object">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="x:Object" Name="WSSessionData" />
            </ActivityAction.Argument>
            <Sequence DisplayName="Steps in Workday" sap2010:Annotation.AnnotationText="Add the Workday actions here. Use Workflows/Workday/SearchAndOpen.xaml to open a task, StartProxy/StopProxy.xaml to act as another worker, and OpenInboxTask.xaml for My Tasks items. Click Submit with DebuggerApi." sap2010:WorkflowViewState.IdRef="Sequence_Steps" />
          </ActivityAction>
        </uix:NApplicationCard.Body>
        <uix:NApplicationCard.TargetApp>
          <uix:TargetApp BrowserType="Edge" Selector="&lt;html app='msedge.exe' title='*Workday*' url='https://impl.workday.com/uipath_dpt1*' /&gt;" Url="https://impl.workday.com/uipath_dpt1/d/home.htmld" Version="V3">
            <uix:TargetApp.SapInfo>
              <uix:SAPElementInfo IsSapSubsystem="False" WebAutomationFramework="Default" />
            </uix:TargetApp.SapInfo>
          </uix:TargetApp>
        </uix:NApplicationCard.TargetApp>
      </uix:NApplicationCard>
    </Sequence>
    <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_Then">
      <Assign DisplayName="Set the expected value" sap2010:WorkflowViewState.IdRef="Assign_Expected">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[expectedValue]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:String">["Successfully Completed"]</InArgument>
        </Assign.Value>
      </Assign>
      <Assign DisplayName="Set the actual value read from Workday (replace with a Get Text)" sap2010:WorkflowViewState.IdRef="Assign_Actual">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[actualValue]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:String">[currentRun.HireEventStatus]</InArgument>
        </Assign.Value>
      </Assign>
      <uta:VerifyExpression KeepScreenshots="{x:Null}" ScreenshotsPath="{x:Null}" AlternativeVerificationTitle="TC-HR-HIRE-XX V-01 replace with what this check proves" ContinueOnFailure="True" DisplayName="TC-HR-HIRE-XX V-01 replace with what this check proves" Expression="[actualValue.Trim() = expectedValue]" sap2010:WorkflowViewState.IdRef="VerifyExpression_1" OutputMessageFormat="[&quot;Workday shows '&quot; &amp; actualValue &amp; &quot;'; expected '&quot; &amp; expectedValue &amp; &quot;'. Result: {Result}.&quot;]" Result="[verifyResult]" TakeScreenshotInCaseOfFailingAssertion="True" TakeScreenshotInCaseOfSucceedingAssertion="True" />
      <Assign DisplayName="Set Passed" sap2010:WorkflowViewState.IdRef="Assign_Passed">
        <Assign.To>
          <OutArgument x:TypeArguments="x:Boolean">[Passed]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:Boolean">[verifyResult]</InArgument>
        </Assign.Value>
      </Assign>
      <Assign DisplayName="Build the summary" sap2010:WorkflowViewState.IdRef="Assign_Summary">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[SummaryMessage]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:String">["RunId=" &amp; currentRun.RunId &amp; "; Passed=" &amp; verifyResult.ToString()]</InArgument>
        </Assign.Value>
      </Assign>
    </Sequence>
  </Sequence>
