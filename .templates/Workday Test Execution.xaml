    <x:Property sap2010:Annotation.AnnotationText="Linked by name to the test case's in_RunId. When set, a failure marks that WorkdayHireRun as Failed." Name="in_RunId" Type="InArgument(x:String)" />
    <x:Property Name="WorkdayUiTimeout" Type="InArgument(x:TimeSpan)" />
  </x:Members>
  <VisualBasic.Settings>
    <x:Null />
  </VisualBasic.Settings>
